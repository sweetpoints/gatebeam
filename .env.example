# One environment file and Compose project per independently deployed gateway.
# Copy real fixed repository digests from the approved build manifest.
GATEBEAM_NGINX_IMAGE=registry.example/gatebeam/edge@sha256:REPLACE_64_HEX
GATEBEAM_MANAGEMENT_IMAGE=registry.example/gatebeam/api@sha256:REPLACE_64_HEX
GATEBEAM_JOBS_IMAGE=registry.example/gatebeam/worker@sha256:REPLACE_64_HEX
GATEBEAM_CA_IMAGE=registry.example/gatebeam/ca@sha256:REPLACE_64_HEX
GATEBEAM_LOG_QUERY_IMAGE=registry.example/gatebeam/query@sha256:REPLACE_64_HEX
COMPOSE_PROJECT_NAME=gatebeam-a
NODE_STORAGE_PREFIX=gatebeam-a
NODE_PRIVATE_ADDRESS=10.42.0.30
GATEBEAM_SECRET_ROOT=/etc/gatebeam/a
# Dedicated gateway ingress. Firewall admits only approved LB/transition sources.
EDGE_BIND=0.0.0.0
# No database server, build, migration or init is started by this Compose file.
# Run migrations and controlled edge initialization separately before first start.

# Rendered from the protected node manifest by gatebeam-admin render-node.
GATEBEAM_NGINX_HEALTH_PORT=19091
GATEBEAM_MANAGEMENT_HEALTH_PORT=19092
GATEBEAM_JOBS_HEALTH_PORT=19093
GATEBEAM_CA_HEALTH_PORT=19094
GATEBEAM_LOG_QUERY_HEALTH_PORT=19095
